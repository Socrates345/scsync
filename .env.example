# Copy to .env (git-ignored) and fill in.

# ntfy topic for scheduled-run alerts (src/sync_sc_playlists.py --unattended).
# Use a topic of its own, not XtoMD's. The topic name works like a password,
# so make it random:
#   python -c "import secrets; print(secrets.token_hex(16))"
# then subscribe to that topic in the ntfy app. Alerts only ever contain counts
# and playlist line numbers, never usernames, links or track names.
SC_NOTIFY_URL=https://ntfy.sh/<random topic>
